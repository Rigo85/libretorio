{
	"name": "libretorio",
	"version": "2.0.0",
	"description": "Backend de Libretorio: catalogo, acceso autenticado a archivos, historial, progreso de lectura y preferencias de usuario.",
	"scripts": {
		"test": "jest",
		"start": "npm run serve",
		"serve": "node dist/server.js",
		"debug": "nodemon --inspect-brk=0.0.0.0:9229 dist/server.js",
		"debug-2": "npm run build && npm run watch-debug",
		"watch-debug": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run serve-debug\"",
		"watch-node": "nodemon dist/server.js",
		"watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
		"watch-ts": "tsc -w",
		"serve-debug": "nodemon --inspect dist/server.js",
		"build": "npm run build-ts && npm run lint && npm run copy-static-assets && npm run 7z-perm",
		"copy-static-assets": "ts-node copyStaticAssets.ts",
		"build-ts": "tsc",
		"lint": "eslint \"src/**/*.ts\"",
		"lint-fix": "eslint --fix \"src/**/*.ts\"",
		"7z-perm": "chmod +x node_modules/7zip-bin/linux/x64/7za",
		"postinstall": "npm run build && npm run 7z-perm"
	},
	"keywords": [],
	"author": "Rigoberto L. Salgado Reyes <rlsalgado2006@gmail.com>",
	"license": "AGPL-3.0",
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"dependencies": {
		"@dr.pogodin/csurf": "^1.16.5",
		"@node-rs/argon2": "^2.0.2",
		"7zip-bin": "^5.2.0",
		"axios": "^1.7.2",
		"chalk": "4.1.2",
		"compression": "^1.7.4",
		"connect-pg-simple": "^10.0.0",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"errorhandler": "^1.5.1",
		"express": "^4.18.2",
		"express-rate-limit": "^7.5.1",
		"express-session": "^1.18.1",
		"fs-extra": "^11.2.0",
		"helmet": "^7.1.0",
		"js-base64": "^3.7.7",
		"lusca": "^1.7.0",
		"module-alias": "^2.2.3",
		"music-metadata": "^11.12.3",
		"node-7z": "^3.0.0",
		"node-unrar-js": "^2.0.2",
		"pg": "^8.11.3",
		"rate-limit-redis": "^4.2.1",
		"redis": "^5.5.6",
		"request-ip": "^3.3.0",
		"string-similarity": "^4.0.4",
		"unzipper": "^0.12.3",
		"uuid": "^11.1.1",
		"ws": "^8.15.1",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/compression": "^1.7.5",
		"@types/connect-pg-simple": "^7.0.3",
		"@types/cors": "^2.8.16",
		"@types/errorhandler": "^1.5.3",
		"@types/express": "^4.17.19",
		"@types/express-session": "^1.18.2",
		"@types/fs-extra": "^11.0.4",
		"@types/lusca": "^1.7.4",
		"@types/node": "^24.13.6",
		"@types/node-7z": "^2.1.8",
		"@types/pg": "^8.10.9",
		"@types/request-ip": "^0.0.41",
		"@types/string-similarity": "^4.0.2",
		"@types/unzipper": "^0.10.10",
		"@types/uuid": "^10.0.0",
		"@types/ws": "^8.5.10",
		"@types/xml2js": "^0.4.14",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"concurrently": "^8.2.2",
		"eslint": "^10.11.0",
		"eslint-plugin-jsdoc": "^64.5.4",
		"eslint-plugin-no-null": "^1.0.2",
		"jest": "^29.7.0",
		"nodemon": "^3.0.1",
		"ts-jest": "^29.1.1",
		"ts-node": "^10.9.1",
		"typescript": "~5.9.3"
	}
}
